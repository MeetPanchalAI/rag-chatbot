# --- Provider ---
OPENAI_API_KEY=
# Optional: point at a different OpenAI-compatible endpoint
OPENAI_BASE_URL=

# --- Models ---
LLM_MODEL=gpt-5.6-luna
# Model used to rewrite follow-up questions. Blank = same as LLM_MODEL.
REWRITE_MODEL=
EMBEDDING_MODEL=text-embedding-3-small

# gpt-5.6-luna is a reasoning model: it only accepts the default temperature.
LLM_TEMPERATURE=1.0
# Blank = do not send the parameter at all (for models that reject it).
LLM_REASONING_EFFORT=low

# --- Storage ---
DATA_DIR=./data
# Where evaluation reports are written
EVAL_DIR=./eval

# --- Chunking ---
CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=75

# --- Retrieval ---
RETRIEVER_TOP_K=6
MAX_CONTEXT_TOKENS=4000

# --- Limits ---
MAX_HISTORY_TURNS=3
MAX_QUESTION_CHARS=2000
MAX_UPLOAD_MB=50
EMBED_BATCH_SIZE=128
REQUEST_TIMEOUT_S=60

# --- Logging ---
LOG_LEVEL=INFO
